import heapq

def prim_mst(graph, start_vertex):
    # Track the edges included in the Minimum Spanning Tree (MST)
    mst = []
    total_weight = 0
    
    # Track visited vertices to avoid cycles
    visited = set()
    
    # Priority queue stores tuples of: (edge_weight, current_vertex, parent_vertex)
    # Start with a weight of 0 from the starting vertex to itself (None parent)
    priority_queue = [(0, start_vertex, None)]
    
    while priority_queue:
        weight, current, parent = heapq.heappop(priority_queue)
        
        # If the vertex is already in the MST, skip it
        if current in visited:
            continue
            
        # Mark the current vertex as visited/included in MST
        visited.add(current)
        total_weight += weight
        
        # If it has a parent, it's a valid MST edge
        if parent is not None:
            mst.append((parent, current, weight))
            
        # Explore all neighbors of the current vertex
        for neighbor, edge_weight in graph[current]:
            if neighbor not in visited:
                heapq.heappush(priority_queue, (edge_weight, neighbor, current))
                
    return mst, total_weight

# --- Example Usage ---

# Define an undirected graph using an adjacency list:
# format: vertex: [(neighbor, weight), ...]
example_graph = {
    'A': [('B', 2), ('C', 3)],
    'B': [('A', 2), ('C', 1), ('D', 1), ('E', 4)],
    'C': [('A', 3), ('B', 1), ('F', 5)],
    'D': [('B', 1), ('E', 1)],
    'E': [('B', 4), ('D', 1), ('F', 1)],
    'F': [('C', 5), ('E', 1)]
}

# Run the algorithm starting from vertex 'A'
mst_edges, total_cost = prim_mst(example_graph, 'A')

print("Edges in the Minimum Spanning Tree:")
for u, v, w in mst_edges:
    print(f"{u} - {v} (Weight: {w})")
print(f"\nTotal MST Weight: {total_cost}")
